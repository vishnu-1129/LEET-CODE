#include <stdbool.h>

// Helper function to calculate the sum of the squares of digits
int getNext(int n) {
    int sum = 0;
    while (n > 0) {
        int digit = n % 10;
        sum += digit * digit;
        n /= 10;
    }
    return sum;
}

bool isHappy(int n) {
    int tortoise = n;
    int hare = getNext(n);
    
    // Move tortoise by 1 step and hare by 2 steps until they meet or hare reaches 1
    while (hare != 1 && tortoise != hare) {
        tortoise = getNext(tortoise);
        hare = getNext(getNext(hare));
    }
    
    // If the hare reached 1, it's a happy number
    return hare == 1;
}
