#include <string.h>

int minimumRecolors(char* blocks, int k) {
    int len = strlen(blocks);
    int currentW = 0;
    
    for (int i = 0; i < k; i++) {
        if (blocks[i] == 'W') {
            currentW++;
        }
    }
    
    int minW = currentW;
    
    for (int i = k; i < len; i++) {
        if (blocks[i] == 'W') {
            currentW++;
        }
        if (blocks[i - k] == 'W') {
            currentW--;
        }
        
        if (currentW < minW) {
            minW = currentW;
        }
    }
    
    return minW;
}
