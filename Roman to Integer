#include <string.h>

// Helper function to return the integer value of a single Roman character
int charToInt(char c) {
    switch (c) {
        case 'I': return 1;
        case 'V': return 5;
        case 'X': return 10;
        case 'L': return 50;
        case 'C': return 100;
        case 'D': return 500;
        case 'M': return 1000;
        default:  return 0;
    }
}

int romanToInt(char* s) {
    int total = 0;
    int len = strlen(s);
    
    for (int i = 0; i < len; i++) {
        int current_val = charToInt(s[i]);
        
        // If there is a next character, check its value
        if (i + 1 < len) {
            int next_val = charToInt(s[i + 1]);
            
            // Subtractive form condition (e.g., IV, XL, CM)
            if (current_val < next_val) {
                total -= current_val;
                continue;
            }
        }
        
        // Standard additive form condition
        total += current_val;
    }
    
    return total;
}
