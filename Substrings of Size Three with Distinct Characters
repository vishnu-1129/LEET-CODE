#include <string.h>

int countGoodSubstrings(char* s) {
    int len = strlen(s);
    int count = 0;
    
    for (int i = 0; i <= len - 3; i++) {
        char a = s[i];
        char b = s[i + 1];
        char c = s[i + 2];
        
        if (a != b && b != c && a != c) {
            count++;
        }
    }
    
    return count;
}
