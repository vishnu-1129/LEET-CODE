void reverse(char* start, char* end) {
    while (start < end) {
        char temp = *start;
        *start = *end;
        *end = temp;
        start++;
        end--;
    }
}

char* reverseWords(char* s) {
    int len = strlen(s);
    int i = 0;
    
    while (i < len) {
        while (i < len && s[i] == ' ') {
            i++;
        }
        
        int start = i;
        while (i < len && s[i] != ' ') {
            i++;
        }
        int end = i - 1;
        
        if (start < end) {
            reverse(&s[start], &s[end]);
        }
    }
    return s;
}
