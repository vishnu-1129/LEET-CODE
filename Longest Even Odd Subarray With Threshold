#include <stdio.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int longestAlternatingSubarray(int* nums, int numsSize, int threshold) {
    int max_len = 0;
    int current_len = 0;
    
    for (int i = 0; i < numsSize; i++) {
        if (current_len > 0 && nums[i] <= threshold && (nums[i] % 2 != nums[i - 1] % 2)) {
            current_len++;
        } else if (nums[i] <= threshold && nums[i] % 2 == 0) {
            current_len = 1;
        } else {
            current_len = 0;
        }
        
        max_len = MAX(max_len, current_len);
    }
    
    return max_len;
}
