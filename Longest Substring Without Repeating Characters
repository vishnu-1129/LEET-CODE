#include <string.h>

// Helper macro to find the maximum of two values
#define MAX(a, b) ((a) > (b) ? (a) : (b))

int lengthOfLongestSubstring(char* s) {
    // Lookup table for ASCII characters, initialized to -1
    int charMap[128];
    for (int i = 0; i < 128; i++) {
        charMap[i] = -1;
    }
    
    int left = 0;
    int maxLength = 0;
    int len = strlen(s);
    
    for (int right = 0; right < len; right++) {
        // Get the ASCII integer value of the character
        unsigned char current_char = s[right];
        
        // If the character was seen and sits inside our current window
        if (charMap[current_char] >= left) {
            left = charMap[current_char] + 1;
        }
        
        // Record or update the index of the current character
        charMap[current_char] = right;
        
        // Track the maximum window size
        maxLength = MAX(maxLength, right - left + 1);
    }
    
    return maxLength;
}
