#include <string.h>
#include <stdlib.h>
#include <ctype.h>

void helper(char* s, int start, int end, int* maxStart, int* maxLen) {
    if (end - start + 1 < 2) return;
    
    int lower[26] = {0};
    int upper[26] = {0};
    
    for (int i = start; i <= end; i++) {
        if (s[i] >= 'a' && s[i] <= 'z') lower[s[i] - 'a'] = 1;
        if (s[i] >= 'A' && s[i] <= 'Z') upper[s[i] - 'A'] = 1;
    }
    
    for (int i = start; i <= end; i++) {
        char c = s[i];
        if ((islower(c) && !upper[c - 'a']) || (isupper(c) && !lower[c - 'A'])) {
            helper(s, start, i - 1, maxStart, maxLen);
            helper(s, i + 1, end, maxStart, maxLen);
            return;
        }
    }
    
    int currentLen = end - start + 1;
    if (currentLen > *maxLen) {
        *maxLen = currentLen;
        *maxStart = start;
    }
}

char* longestNiceSubstring(char* s) {
    int len = strlen(s);
    int maxStart = 0;
    int maxLen = 0;
    
    helper(s, 0, len - 1, &maxStart, &maxLen);
    
    char* result = (char*)malloc((maxLen + 1) * sizeof(char));
    strncpy(result, s + maxStart, maxLen);
    result[maxLen] = '\0';
    
    return result;
}
