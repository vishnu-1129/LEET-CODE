#include <stdbool.h>
#include <string.h>

bool isIsomorphic(char* s, char* t) {
    int map_s[256] = {0};
    int map_t[256] = {0};
    
    int i = 0;
    while (s[i] != '\0') {
        unsigned char char_s = s[i];
        unsigned char char_t = t[i];
        
        if (map_s[char_s] != map_t[char_t]) {
            return false;
        }
        
        map_s[char_s] = i + 1;
        map_t[char_t] = i + 1;
        
        i++;
    }
    
    return true;
}
